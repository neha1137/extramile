rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function myProfile() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    function isEvaluator() {
      return signedIn() && (myProfile().role == 'evaluator' || myProfile().role == 'admin');
    }

    match /submissions/{uid}/{taskId}/{fileName} {
      allow write: if signedIn() && request.auth.uid == uid && request.resource.size < 25 * 1024 * 1024;
      allow read: if signedIn() && (request.auth.uid == uid || isEvaluator());
      allow delete: if signedIn() && (request.auth.uid == uid || isEvaluator());
    }

    match /profile/{uid}/{fileName} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }
  }
}
