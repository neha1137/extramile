rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return signedIn() && myProfile().role == 'admin';
    }

    function isEvaluator() {
      return signedIn() && (myProfile().role == 'evaluator' || myProfile().role == 'admin');
    }

    function isMentor() {
      return signedIn() && (myProfile().role == 'mentor' || myProfile().role == 'admin');
    }

    match /users/{uid} {
      allow create: if isAdmin();

      // Signed-in users can see active community profiles. A user can always
      // read their own profile, including when it is inactive.
      allow read: if signedIn() && (
        resource.data.active == true ||
        request.auth.uid == uid
      );

      allow update: if isAdmin() ||
        (signedIn() && request.auth.uid == uid &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.userId == resource.data.userId &&
          request.resource.data.active == resource.data.active);

      // Evaluators may only change the numeric progress fields when an
      // evaluation awards XP. They cannot edit the student's identity/role.
      allow update: if isEvaluator() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'xp', 'level', 'updatedAt'
        ]);

      allow delete: if isAdmin();
    }

    match /tasks/{taskId} {
      allow read: if signedIn();
      allow create, update, delete: if isEvaluator();
    }

    match /submissions/{submissionId} {
      allow create: if signedIn() && request.resource.data.studentId == request.auth.uid;
      allow read: if signedIn() && (
        resource.data.studentId == request.auth.uid || isEvaluator()
      );
      allow update: if isEvaluator() || (
        signedIn() && resource.data.studentId == request.auth.uid &&
        resource.data.status == 'draft'
      );
      allow delete: if isAdmin();
    }


    match /mentorshipRequests/{requestId} {
      allow read: if signedIn() && (
        resource.data.studentId == request.auth.uid ||
        resource.data.mentorId == request.auth.uid ||
        isAdmin()
      );

      allow create: if signedIn()
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.status == 'pending'
        && get(/databases/$(database)/documents/users/$(request.resource.data.mentorId)).data.role == 'mentor'
        && get(/databases/$(database)/documents/users/$(request.resource.data.mentorId)).data.active == true
        && get(/databases/$(database)/documents/users/$(request.resource.data.mentorId)).data.acceptingMentorshipRequests == true;

      allow update: if isAdmin() ||
        (signedIn()
          && resource.data.mentorId == request.auth.uid
          && request.resource.data.mentorId == resource.data.mentorId
          && request.resource.data.studentId == resource.data.studentId
          && request.resource.data.status in ['accepted', 'declined']);

      allow delete: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if signedIn() && resource.data.recipientId == request.auth.uid;

      allow create: if isEvaluator() && request.resource.data.recipientId != null
        || (signedIn()
          && request.resource.data.type == 'mentor_request'
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.requestId != null
          && getAfter(/databases/$(database)/documents/mentorshipRequests/$(request.resource.data.requestId)).data.studentId == request.auth.uid
          && getAfter(/databases/$(database)/documents/mentorshipRequests/$(request.resource.data.requestId)).data.mentorId == request.resource.data.recipientId)
        || (signedIn()
          && request.resource.data.type == 'mentor_response'
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.requestId != null
          && getAfter(/databases/$(database)/documents/mentorshipRequests/$(request.resource.data.requestId)).data.mentorId == request.auth.uid
          && getAfter(/databases/$(database)/documents/mentorshipRequests/$(request.resource.data.requestId)).data.studentId == request.resource.data.recipientId);

      allow update: if signedIn() && resource.data.recipientId == request.auth.uid;
      allow delete: if isAdmin();
    }

    match /calendarEvents/{eventId} {
      allow read: if signedIn() && (
        resource.data.visibility == 'all' ||
        resource.data.createdBy == request.auth.uid ||
        request.auth.uid in resource.data.participantIds
      );

      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && (
          request.resource.data.visibility == 'personal' ||
          request.resource.data.visibility == 'all' ||
          (request.resource.data.visibility == 'participants' && request.auth.uid in request.resource.data.participantIds)
        );

      allow update: if signedIn() && (
        resource.data.createdBy == request.auth.uid || isAdmin()
      );

      allow delete: if signedIn() && (
        resource.data.createdBy == request.auth.uid || isAdmin()
      );
    }

    match /opportunities/{id} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /events/{id} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /announcements/{id} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /mentors/{id} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /resources/{id} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    // Upload sessions are server-only. The Admin SDK creates and verifies them.
    match /driveUploadSessions/{sessionId} {
      allow read, write: if false;
    }
  }
}
