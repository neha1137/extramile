# Firebase Web App configuration
# Get these values from Firebase Console -> Project settings -> Your apps -> Web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional local backend URL. Leave blank in Vercel so the frontend uses the same /api origin.
VITE_DRIVE_API_URL=http://localhost:4000

# Production/local API settings (keep secrets in server/.env or hosting environment variables)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=
# GOOGLE_DRIVE_ROOT_FOLDER_ID=
# FIREBASE_SERVICE_ACCOUNT_JSON=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=

# Server-side only: shared starter password for admin-created member accounts.
# Set this in Vercel Environment Variables, never with a VITE_ prefix.
# EXTRA_MILER_INITIAL_PASSWORD=replace-with-a-strong-starter-password
